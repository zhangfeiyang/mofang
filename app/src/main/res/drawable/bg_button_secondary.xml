<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#0DFFFFFF" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#14FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_raised" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
